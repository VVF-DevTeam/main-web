generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model EventCategory {
  id        String       @id @default(cuid())
  title     String
  bgColor   String
  isBold    Boolean      @default(false)
  isItalic  Boolean      @default(false)
  textColor String
  type      CategoryType
  post      Post[]       @relation("EventCategoryToPost")
  event     Event[]      @relation("EventToEventCategory")
}

model Event {
  id                 String          @id @default(cuid())
  keyName            String          @unique // keyName is made using title
  title              String          @unique
  description        String?
  location           String?
  days               String[]
  eventType          EventType

  startTime          String?
  endTime            String?
  startDate          DateTime?       @default(now())
  endDate            DateTime        @default(now())
  capacity           Int?


  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  formLink           String?
  imgUrl             String?
  isPublished        Boolean         @default(false)
  stripePriceId      String?
  stripeProductId    String?
  subscribedPriceId  String?
  socialLinks        Json?
  subtitle           String?
  subImgUrls         Json?
  imgUrls            Json?
  seatingMap         Json?
  eventHosts         Json?
  eventDiscounts     Json?
  eventCodeDiscounts Json?

  // Relations
  seriesId           String?
  sponsors           SponsorOnEvent[]
  series             EventSeries?    @relation(fields: [seriesId], references: [id])
  schedules          EventSchedule[]
  tickets            EventTicket[]
  payments           Payment[]
  Review             Review[]
  form               EventForm[]
  jobs               Job[]
  categories         EventCategory[] @relation("EventToEventCategory")
  hosts              User[]          @relation("EventToUser")

  @@unique([title, eventType])
  @@index([id])
}

model EventSponsor {
  id          String             @id @default(cuid())
  name        String             @unique
  displayName Boolean            @default(false)
  imgUrl      String
  url         String?    
  description String?
  events      SponsorOnEvent[]
}

model SponsorOnEvent {
  id        String       @id @default(cuid())
  eventId   String
  sponsorId String
  tier      SponsorTier  @default(Bronze)
  order     Int?         // Optional: for custom ordering within each tier
  createdAt DateTime     @default(now())
  event     Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  sponsor   EventSponsor @relation(fields: [sponsorId], references: [id], onDelete: Cascade)

  @@unique([eventId, sponsorId])
  @@index([eventId])
  @@index([sponsorId])
}

model EventSeries {
  id          String    @id @default(cuid())
  name        String    @unique
  keyName     String    @unique
  description String?
  eventType   EventType
  events      Event[]
}

model EventSchedule {
  id          String  @id @default(cuid())
  description String?
  startTime   String?
  endTime     String?
  position    Int
  eventId     String
  event       Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model EventTicket {
  id        String     @id @default(cuid())
  createdAt DateTime   @default(now())
  updatedAt DateTime   @default(now())
  type      String
  imageUrl  String?    // Background for the ticket
  limit     Int?

  // Price and payment mode
  price     Decimal
  currency  String     @default("CAD")
  discountMemberPercent Int?
  payTotalNumber Int  @default(1) // this field represents the number of session this ticket has

  // Capacity just for this tier
  capacityPerTicket Int @default(1)

  // Time range
  validFrom   DateTime?
  validTo     DateTime?

  // Stripe catalog mapping
  stripeProductId String
  stripePriceId   String
  subscribedStripePriceId String?

  // Relation
  eventId   String
  event     Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  payments  Payment[]
}

model EventForm {
  id        String     @id @default(cuid())
  createdAt DateTime   @default(now())
  updatedAt DateTime   @default(now())


  // Relation
  eventId   String
  event     Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)

  // Data
  FormData Json
}

model User {
  id                   String        @id @default(cuid())
  name                 String?
  email                String        @unique
  age                  String?
  phone                String?       @unique
  address              String?
  password             String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  emailVerified        DateTime?
  image                String?
  role                 Role[]
  stripeSubscriptionId String?
  subscribeExpires     DateTime?
  subscribedAt         DateTime?
  phoneVerified        Boolean?      @default(false)
  accounts             Account[]
  applications         Application[]
  jobs                 Job[]
  payments             Payment[]
  posts                Post[]
  likedPosts           PostLikes[]
  visitedPosts         PostVisits[]
  Review               Review[]
  Devices              UserDevice[]
  EventHost            Event[]       @relation("EventToUser")
}

model UserDevice {
  id     String @id @default(cuid())
  userId String
  token  String @unique
  User   User   @relation(fields: [userId], references: [id])
}

model Post {
  id          String          @id @default(cuid())
  title       String          @unique
  content     String?
  summary     String?
  imgUrl      String?
  isPublished Boolean?        @default(false)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  postLikes   PostLikes[]
  postVisits  PostVisits[]
  categories  EventCategory[] @relation("EventCategoryToPost")

  @@unique([id, userId])
  @@index([id])
}

model Job {
  id           String        @id @default(cuid())
  title        String        @unique
  keyName      String        @unique
  description  String?
  jobType      JobType
  summary      String?
  startDate    DateTime?     @default(now())
  endDate      DateTime?     @default(now())
  location     String?
  isPublished  Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  userId       String
  eventId      String?
  applications Application[]
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  event        Event?        @relation(fields: [eventId], references: [id], onDelete: Cascade)


  @@unique([id, userId])
  @@index([id])
}

model Application {
  id              String   @id @default(uuid())
  firstName       String
  lastName        String
  address         String
  city            String
  country         String
  postCode        String
  email           String
  phoneNumber     String
  resume          Bytes
  appliedAt       DateTime @default(now())
  jobId           String?
  userId          String
  positionToApply String?
  reasonToApply   String?
  job             Job?     @relation(fields: [jobId], references: [id])
  user            User     @relation(fields: [userId], references: [id])

  @@unique([jobId, userId])
  @@index([id])
}

model Payment {
  id              String      @id @default(cuid())
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  type            PaymentType
  method          PaymentMethod @default(Stripe)
  expiresAt       DateTime?
  quantity        Int

  // Stripe 
  stripePaymentId String?

  // info
  pricePaid       Decimal
  refunded        Boolean     @default(false)
  seatNumber      String?
  
  // Guests information
  guestName       String?
  guestEmail      String?
  guestPhone      String?
  otherGuests     Json?

  // Relations
  userId          String?
  eventId         String?
  eventTicketId   String?
  event           Event?       @relation(fields: [eventId], references: [id], onDelete: Restrict)
  user            User?        @relation(fields: [userId], references: [id])
  eventTicket     EventTicket? @relation(fields: [eventTicketId], references: [id])

}

model CheckoutSessionData {
  id              String   @id @default(cuid())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  // Representative guest (main contact)
  guestName       String?
  guestEmail      String?
  guestPhone      String?
  
  // Seat and ticket data
  seatNumbers     Json?
  ticketMetadata  Json             // Required - always present
  otherGuestsInfo Json?            // Other guests (array)
  
  stripeSessionId String? @unique // Optional initially, set after session creation

  @@index([stripeSessionId]) // Fast lookup in webhook
  @@index([createdAt])       // For cleanup jobs (delete old records)
} 

model PostLikes {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  postId    String
  userId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
}

model PostVisits {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  postId    String
  userId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model VerificationToken {
  id      String   @id @default(cuid())
  email   String
  token   String   @unique
  expires DateTime

  @@unique([email, token])
}

model Review {
  id        String       @id @default(cuid())
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  userId    String
  eventId   String?
  rating    ReviewRating
  comment   String
  anonymous Boolean      @default(false)
  imageLink String?
  event     Event?       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Role {
  USER
  ADMIN
  HOST
}

enum EventType {
  CLASS
  CONCERT
  CAMPING
  EVENT
}

enum JobType {
  Performance
  Marketing
  ProjectManager
  HR
  Tech
  Finance
  Volunteer
}

enum CategoryType {
  Primary
  Secondary
}

enum PaymentType {
  Membership
  ClassFullCourse
  ClassDropIn
  Concert
  Camping
  Event
}

enum PaymentMethod {
  ETF
  BankTransfer
  Cash
  Stripe
  None
}

enum ReviewRating {
  One   @map("1")
  Two   @map("2")
  Three @map("3")
  Four  @map("4")
  Five  @map("5")
}

enum SponsorTier {
  Platinum
  Gold
  Silver
  Bronze
}
