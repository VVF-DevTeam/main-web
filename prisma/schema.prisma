// schema.prisma

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model EventCategory {
  id        String       @id @default(cuid())
  title     String
  bgColor   String
  textColor String
  isBold    Boolean      @default(false)
  isItalic  Boolean      @default(false)
  type      CategoryType
  eventId   String?
  event     Event[]
  post      Post[]
}

model Event {
  id          String    @id @default(cuid())
  title       String    @unique
  keyName     String    @unique 
  eventType   EventType
  description String?
  imgUrl      String?
  formLink    String?
  stripeProductId String?
  stripePriceId String?
  // Metadata
  location    String?
  price       Decimal?      @default(0)
  startDate   DateTime? @default(now())
  endDate     DateTime  @default(now())
  days        String[]
  capacity    Int?
  ticketsSold Int?
  startTime   String?
  endTime     String?

  // States
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  hosts      User[]
  categories EventCategory[]
  tickets    EventTicket[]
  schedules  EventSchedule[]
  payments   Payment[]

  @@unique([title, eventType])
  @@index([id])
}

model EventSchedule {
  id          String  @id @default(cuid())
  description String?
  startTime   String?
  endTime     String?
  position    Int
  eventId     String
  event       Event   @relation(fields: [eventId], references: [id])
}

model EventTicket {
  id        String     @id @default(cuid())
  createdAt DateTime   @default(now())
  updatedAt DateTime   @default(now())
  type      TicketType
  price     Float
  capacity  Int

  // relation
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

// Ticket tiers
model Ticket {
  id          String  @id @default(cuid())
  title       String?
  description String?
  price       Float
  eventId     String

  // States
  published Boolean  @default(false)
  updatedAt DateTime @default(now())
  createdAt DateTime @updatedAt

  // For ticket checking
  consumed Boolean @default(false)

  // Relations
  purchases Purchase[]
}

// Act like a purchased ticket
model Purchase {
  id            String  @id @default(cuid())
  user          User    @relation(fields: [userId], references: [id])
  userId        String
  ticket        Ticket  @relation(fields: [ticketId], references: [id])
  ticketId      String
  paymentMethod String?

  @@unique([userId, ticketId])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]

  role     Role[]
  age      String?
  phone    String? @unique
  address  String?
  password String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchases    Purchase[]
  posts        Post[]
  likedPosts   PostLikes[]
  visitedPosts PostVisits[]
  EventHost    Event[]
  jobs         Job[]
  applications Application[]
  payments     Payment[]
}

// Posts made by admins
model Post {
  id          String   @id @default(cuid())
  title       String   @unique
  content     String?
  summary     String?
  imgUrl      String?
  isPublished Boolean? @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  postLikes  PostLikes[]
  postVisits PostVisits[]
  categories EventCategory[]

  // relation
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([id, userId])
  @@index([id])
}

// Jobs made by admins
model Job {
  id          String   @id @default(cuid())
  title       String   @unique
  keyName     String   @unique

  // Metadata
  description     String?
  jobType     JobType
  summary     String?
  startDate   DateTime? @default(now())
  endDate     DateTime? @default(now())
  location    String?

  // States
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // relation
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications Application[]
  
  @@unique([id, userId])
  @@index([id])
}

model Application {
  id       String   @id @default(uuid())

  // Metadata
  firstName     String
  lastName     String
  address  String
  city     String
  country  String
  postCode String
  email    String
  phoneNumber String
  resume   Bytes

  // States
  appliedAt DateTime @default(now())

  // Relations
  jobId    String
  job      Job      @relation(fields: [jobId], references: [id])
  userId   String
  user     User     @relation(fields: [userId], references: [id]) 

  @@unique([jobId, userId])
  @@index([id])
}

model Payment {
  id String @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  type PaymentType
  
  // Relations
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  eventId String?
  event   Event?  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  // These fields below are changeable by host and admin, so we save them as the snapshot instead of joining them through Event table
  stripeProductId String   // Immutable snapshot of what was sold
  stripePriceId   String   // Immutable snapshot of price paid
  pricePaid       Decimal  // Actual amount charged, always saved

  @@unique([userId, eventId]) // Only if one payment per user per event is guaranteed
}

model PostLikes {
  id String @id @default(cuid())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // relations
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
}

model PostVisits {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // relations
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model VerificationToken {
  id      String   @id @default(cuid())
  email   String
  token   String   @unique
  expires DateTime

  @@unique([email, token])
}

enum Role {
  USER
  ADMIN
  HOST
}

enum EventType {
  CLASS
  CONCERT
}

enum JobType {
  Media
  Operations
  Event
  HR
  Tech
}

enum CategoryType {
  Primary
  Secondary
}

enum TicketType {
  NonMember
  Member
  DropIn
}

enum PaymentType {
  Membership
  Class
  Concert
}