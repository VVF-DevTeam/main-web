generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model EventCategory {
  id        String       @id @default(cuid())
  title     String
  bgColor   String
  eventId   String?
  isBold    Boolean      @default(false)
  isItalic  Boolean      @default(false)
  textColor String
  type      CategoryType
  post      Post[]       @relation("EventCategoryToPost")
  event     Event[]      @relation("EventToEventCategory")
}

model Event {
  id                 String          @id @default(cuid())
  title              String          @unique
  subtitle           String?         // Optional subtitle field
  description        String?
  location           String?
  startTime          String?
  endTime            String?
  capacity           Int?
  ticketsSold        Int?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  days               String[]
  endDate            DateTime        @default(now())
  eventType          EventType
  formLink           String?
  fullCourseDiscount Int?
  imgUrl             String?
  subImgUrls         Json?           // Array of sub-image URLs for concert events
  imgUrls            Json?           // Array of gallery image URLs
  isPublished        Boolean         @default(false)
  keyName            String          @unique
  price              Decimal?        @default(0)
  startDate          DateTime?       @default(now())
  stripePriceId      String?
  stripeProductId    String?
  subscribedPriceId  String?
  socialLinks        Json?           // Array of { platform: string, url: string }
  schedules          EventSchedule[]
  tickets            EventTicket[]
  payments           Payment[]
  categories         EventCategory[] @relation("EventToEventCategory")
  hosts              User[]          @relation("EventToUser")

  @@unique([title, eventType])
  @@index([id])
}

model EventSchedule {
  id          String  @id @default(cuid())
  description String?
  startTime   String?
  endTime     String?
  position    Int
  eventId     String
  event       Event   @relation(fields: [eventId], references: [id])
}

model EventTicket {
  id        String     @id @default(cuid())
  createdAt DateTime   @default(now())
  updatedAt DateTime   @default(now())
  type      TicketType
  price     Float
  capacity  Int
  eventId   String
  event     Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model Ticket {
  id          String     @id @default(cuid())
  title       String?
  description String?
  price       Float
  eventId     String
  published   Boolean    @default(false)
  updatedAt   DateTime   @default(now())
  createdAt   DateTime   @updatedAt
  consumed    Boolean    @default(false)
  purchases   Purchase[]
}

model Purchase {
  id            String  @id @default(cuid())
  userId        String
  ticketId      String
  paymentMethod String?
  ticket        Ticket  @relation(fields: [ticketId], references: [id])
  user          User    @relation(fields: [userId], references: [id])

  @@unique([userId, ticketId])
}

model User {
  id                   String        @id @default(cuid())
  name                 String?
  email                String        @unique
  age                  String?
  phone                String?       @unique
  address              String?
  password             String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  emailVerified        DateTime?
  image                String?
  role                 Role[]
  stripeSubscriptionId String?
  subscribeExpires     DateTime?
  subscribedAt         DateTime?
  phoneVerified        Boolean?      @default(false)
  accounts             Account[]
  applications         Application[]
  jobs                 Job[]
  payments             Payment[]
  posts                Post[]
  likedPosts           PostLikes[]
  visitedPosts         PostVisits[]
  purchases            Purchase[]
  EventHost            Event[]       @relation("EventToUser")
  Devices              UserDevice[]
}

model UserDevice {
  id String @id @default(cuid())
  userId String
  token String @unique
  User User @relation(fields: [userId], references: [id])
}

model Post {
  id          String          @id @default(cuid())
  title       String          @unique
  content     String?
  summary     String?
  imgUrl      String?
  isPublished Boolean?        @default(false)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  postLikes   PostLikes[]
  postVisits  PostVisits[]
  categories  EventCategory[] @relation("EventCategoryToPost")

  @@unique([id, userId])
  @@index([id])
}

model Job {
  id           String        @id @default(cuid())
  title        String        @unique
  keyName      String        @unique
  description  String?
  jobType      JobType
  summary      String?
  startDate    DateTime?     @default(now())
  endDate      DateTime?     @default(now())
  location     String?
  isPublished  Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  userId       String
  applications Application[]
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([id, userId])
  @@index([id])
}

model Application {
  id          String   @id @default(uuid())
  firstName   String
  lastName    String
  address     String
  city        String
  country     String
  postCode    String
  email       String
  phoneNumber String
  resume      Bytes
  appliedAt   DateTime @default(now())
  jobId       String
  userId      String
  job         Job      @relation(fields: [jobId], references: [id])
  user        User     @relation(fields: [userId], references: [id])

  @@unique([jobId, userId])
  @@index([id])
}

model Payment {
  id              String      @id @default(cuid())
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  type            PaymentType
  expiresAt       DateTime?
  quantity        Int
  userId          String?
  eventId         String?
  stripeProductId String
  stripePriceId   String
  stripePaymentId String
  pricePaid       Decimal
  refunded        Boolean     @default(false)
  event           Event?      @relation(fields: [eventId], references: [id], onDelete: SetNull)
  user            User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model PostLikes {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  postId    String
  userId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
}

model PostVisits {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  postId    String
  userId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model VerificationToken {
  id      String   @id @default(cuid())
  email   String
  token   String   @unique
  expires DateTime

  @@unique([email, token])
}

enum Role {
  USER
  ADMIN
  HOST
}

enum EventType {
  CLASS
  CONCERT
  CAMPING
  EVENT
}

enum JobType {
  Media
  Operations
  Event
  HR
  Tech
}

enum CategoryType {
  Primary
  Secondary
}

enum TicketType {
  NonMember
  Member
  DropIn
}

enum PaymentType {
  Membership
  ClassFullCourse
  ClassDropIn
  Concert
  Camping
  Event
}
